# Z100 XC7Z100 camera and MS7210 parallel HDMI_OUT pins.
# Pin assignments follow the vendor Z100 ZYNQ_IO.xdc.
set_property -dict {PACKAGE_PIN U22 IOSTANDARD LVCMOS33} [get_ports cmos1_pclk]
set_property -dict {PACKAGE_PIN W29 IOSTANDARD LVCMOS33} [get_ports cmos1_vsync]
set_property -dict {PACKAGE_PIN W30 IOSTANDARD LVCMOS33} [get_ports cmos1_href]
set_property -dict {PACKAGE_PIN V24 IOSTANDARD LVCMOS33} [get_ports {cmos_rstn_tri_o[0]}]
set_property -dict {PACKAGE_PIN V22 IOSTANDARD LVCMOS33} [get_ports cam_pwdn]
set_property -dict {PACKAGE_PIN W25 IOSTANDARD LVCMOS33 PULLUP true} [get_ports cmos1_i2c_scl_io]
set_property -dict {PACKAGE_PIN W26 IOSTANDARD LVCMOS33 PULLUP true} [get_ports cmos1_i2c_sda_io]

set_property -dict {PACKAGE_PIN T23 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[0]}]
set_property -dict {PACKAGE_PIN V29 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[1]}]
set_property -dict {PACKAGE_PIN T22 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[2]}]
set_property -dict {PACKAGE_PIN U27 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[3]}]
set_property -dict {PACKAGE_PIN V23 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[4]}]
set_property -dict {PACKAGE_PIN U25 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[5]}]
set_property -dict {PACKAGE_PIN W24 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[6]}]
set_property -dict {PACKAGE_PIN V26 IOSTANDARD LVCMOS33} [get_ports {cmos1_d[7]}]

set_property -dict {PACKAGE_PIN U26 IOSTANDARD LVCMOS33} [get_ports video_clk_out]
set_property -dict {PACKAGE_PIN U30 IOSTANDARD LVCMOS33} [get_ports vid_io_out_0_active_video]
set_property -dict {PACKAGE_PIN R21 IOSTANDARD LVCMOS33} [get_ports vid_io_out_0_hsync]
set_property -dict {PACKAGE_PIN P21 IOSTANDARD LVCMOS33} [get_ports vid_io_out_0_vsync]
set_property -dict {PACKAGE_PIN T30 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[0]}]
set_property -dict {PACKAGE_PIN T28 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[1]}]
set_property -dict {PACKAGE_PIN R28 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[2]}]
set_property -dict {PACKAGE_PIN R25 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[3]}]
set_property -dict {PACKAGE_PIN P30 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[4]}]
set_property -dict {PACKAGE_PIN P29 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[5]}]
set_property -dict {PACKAGE_PIN N29 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[6]}]
set_property -dict {PACKAGE_PIN R26 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[7]}]
set_property -dict {PACKAGE_PIN W28 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[8]}]
set_property -dict {PACKAGE_PIN U29 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[9]}]
set_property -dict {PACKAGE_PIN T29 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[10]}]
set_property -dict {PACKAGE_PIN R30 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[11]}]
set_property -dict {PACKAGE_PIN T25 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[12]}]
set_property -dict {PACKAGE_PIN P24 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[13]}]
set_property -dict {PACKAGE_PIN T24 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[14]}]
set_property -dict {PACKAGE_PIN T27 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[15]}]
set_property -dict {PACKAGE_PIN R27 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[16]}]
set_property -dict {PACKAGE_PIN P25 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[17]}]
set_property -dict {PACKAGE_PIN P26 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[18]}]
set_property -dict {PACKAGE_PIN P28 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[19]}]
set_property -dict {PACKAGE_PIN N27 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[20]}]
set_property -dict {PACKAGE_PIN N28 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[21]}]
set_property -dict {PACKAGE_PIN N26 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[22]}]
set_property -dict {PACKAGE_PIN V27 IOSTANDARD LVCMOS33} [get_ports {vid_io_out_0_data[23]}]

set_property -dict {PACKAGE_PIN J13 IOSTANDARD LVCMOS18 PULLUP true} [get_ports mode_key]
set_property -dict {PACKAGE_PIN H13 IOSTANDARD LVCMOS18 PULLUP true} [get_ports pause_key]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets cmos1_pclk_IBUF]
