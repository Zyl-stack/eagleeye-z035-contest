# Z100 HDMI_OUT MS7210 control pins, from the vendor Z100 ZYNQ_IO.xdc.
set_property PACKAGE_PIN F14 [get_ports hdmi_rstn_0]
set_property IOSTANDARD LVCMOS18 [get_ports hdmi_rstn_0]

set_property PACKAGE_PIN D16 [get_ports hdmi_i2c_scl_0]
set_property IOSTANDARD LVCMOS18 [get_ports hdmi_i2c_scl_0]

set_property PACKAGE_PIN C16 [get_ports hdmi_i2c_sda_0]
set_property IOSTANDARD LVCMOS18 [get_ports hdmi_i2c_sda_0]
