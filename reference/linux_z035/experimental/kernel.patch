--- /dev/null
+++ b/drivers/base/ee_rawio_isolation.c
@@ -0,0 +1,17 @@
+/* Built INTO the experimental kernel, never into a loadable provider module.
+ * No runtime flag can promote the existing unrestricted /dev/mem kernel.
+ */
+#include <linux/kconfig.h>
+#include <linux/export.h>
+#include <linux/types.h>
+#ifdef MODULE
+#error This isolation marker must be built into the experimental kernel
+#endif
+u32 ee_rawio_isolation_v1(void)
+{
+ return (IS_ENABLED(CONFIG_DEVMEM) || IS_ENABLED(CONFIG_DEVKMEM) ||
+         IS_ENABLED(CONFIG_DEVPORT) || IS_ENABLED(CONFIG_UIO) ||
+         IS_ENABLED(CONFIG_VFIO) || IS_ENABLED(CONFIG_PCI) ||
+         IS_ENABLED(CONFIG_OF_CONFIGFS) || !IS_ENABLED(CONFIG_MODULE_SIG_FORCE))?0:0x45454931u;
+}
+EXPORT_SYMBOL_GPL(ee_rawio_isolation_v1);
